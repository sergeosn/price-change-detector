# --- Django -------------------------------------------------------------------
# Required. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL with pgvector) ---------------------------------------
# Required. This value is for running the code on the host against the compose `db`
# service; inside Docker, docker-compose.yml overrides it to point at the `db` host.
DATABASE_URL=postgres://pcd:pcd@localhost:5432/pcd
# Password of the `pcd` user in the compose `db` service. It is applied when the
# database volume is first created; keep it in sync with DATABASE_URL above.
# POSTGRES_PASSWORD=pcd
# Tests create and drop their own `test_pcd` database on this server.
# TEST_DATABASE_URL=postgres://pcd:pcd@localhost:5432/pcd

# --- API ----------------------------------------------------------------------
# Required. Sent by clients in the X-API-Key header.
API_KEY=
# Comma-separated browser origins allowed to call the API (CORS). Empty disables CORS.
# The default below allows the Vite dev (5173) and preview (4173) servers.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Scheduler ----------------------------------------------------------------
CHECK_INTERVAL_HOURS=24
SCHEDULER_TICK_SECONDS=60
REQUEST_DELAY_MIN=1
REQUEST_DELAY_MAX=3

# --- Page fetching ------------------------------------------------------------
FETCH_TIMEOUT_SECONDS=15
FETCH_ACCEPT_LANGUAGE=uk,ru;q=0.9,en;q=0.8

# --- Embeddings ----------------------------------------------------------------
# Sentence-transformers model for chunk embeddings; downloaded on first use. After changing
# it, run `manage.py embed_chunks` to re-embed. The vector column is 384 wide: a model with
# other dimensions also needs EMBEDDING_DIMENSIONS and a migration of Chunk.embedding.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# --- Question answering (optional; POST /api/v1/ask returns 503 while any is empty) ---
# An OpenAI-compatible chat completions API, e.g. a LiteLLM proxy: its base URL (with /v1),
# a key for it and the model name as the proxy knows it. Only these variables are used:
# OPENAI_* and ANTHROPIC_* variables of the environment are ignored.
PCD_LLM_BASE_URL=
PCD_LLM_AUTH_TOKEN=
PCD_LLM_MODEL=

# --- Telegram (optional; notifications are off while either value is empty) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

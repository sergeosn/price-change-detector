# --- Django -------------------------------------------------------------------
# Required. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to <project>/data/db.sqlite3 (in Docker: /app/data/db.sqlite3)
# DATABASE_URL=sqlite:////app/data/db.sqlite3

# --- API ----------------------------------------------------------------------
# Required. Sent by clients in the X-API-Key header.
API_KEY=

# --- Scheduler ----------------------------------------------------------------
CHECK_INTERVAL_HOURS=24
SCHEDULER_TICK_SECONDS=60
REQUEST_DELAY_MIN=1
REQUEST_DELAY_MAX=3

# --- Page fetching ------------------------------------------------------------
FETCH_TIMEOUT_SECONDS=15
FETCH_ACCEPT_LANGUAGE=uk,ru;q=0.9,en;q=0.8

# --- Telegram (optional; notifications are off while either value is empty) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
